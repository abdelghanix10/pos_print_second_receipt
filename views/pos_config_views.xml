<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_second_receipt" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.second_receipt</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="Second Receipt &amp; Custom Design"
                         help="Automatically print a second customizable receipt after the main receipt.">
                    <field name="second_receipt_enabled"/>
                    <div class="content-group mt16" invisible="not second_receipt_enabled">
                        <div class="row mt8">
                            <label for="second_receipt_print_method" class="col-lg-5 o_light_label"/>
                            <field name="second_receipt_print_method" widget="radio"/>
                        </div>
                        <div class="row mt8">
                            <label for="second_receipt_delay_ms" class="col-lg-5 o_light_label"/>
                            <field name="second_receipt_delay_ms"/>
                        </div>
                        <div class="row mt8">
                            <label for="second_receipt_categ_ids" class="col-lg-5 o_light_label"/>
                            <field name="second_receipt_categ_ids"
                                   widget="many2many_tags"
                                   placeholder="All POS Categories"/>
                        </div>
                        <div class="row mt8">
                            <label for="is_custom_second_receipt" class="col-lg-5 o_light_label fw-bold"/>
                            <field name="is_custom_second_receipt"/>
                        </div>
                        <div class="row mt8" invisible="not is_custom_second_receipt">
                            <label for="second_receipt_design_id" class="col-lg-5 o_light_label"/>
                            <field name="second_receipt_design_id" required="is_custom_second_receipt"/>
                        </div>
                        <div class="mt8" invisible="is_custom_second_receipt">
                            <div class="row mt8">
                                <label for="second_receipt_title" class="col-lg-5 o_light_label"/>
                                <field name="second_receipt_title"/>
                            </div>
                            <div class="row mt8">
                                <label for="second_receipt_show_prices" class="col-lg-5 o_light_label"/>
                                <field name="second_receipt_show_prices"/>
                            </div>
                            <div class="row mt8">
                                <label for="second_receipt_show_cashier" class="col-lg-5 o_light_label"/>
                                <field name="second_receipt_show_cashier"/>
                            </div>
                            <div class="row mt8">
                                <label for="second_receipt_show_notes" class="col-lg-5 o_light_label"/>
                                <field name="second_receipt_show_notes"/>
                            </div>
                            <div class="row mt8">
                                <label for="second_receipt_footer_text" class="col-lg-5 o_light_label"/>
                                <field name="second_receipt_footer_text" placeholder="Optional footer note..."/>
                            </div>
                        </div>
                        <field name="second_design_receipt" invisible="1"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>